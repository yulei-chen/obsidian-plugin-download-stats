# The database is not committed: a daily hundred-megabyte binary commit would
# grow .git without bound. It is kept as a release asset instead, see
# .github/workflows/daily.yml.
stats.db
stats.db-*
*.db.gz

# Generated by scripts/export.py and deployed as a Pages artifact, not committed
site/data/

# Local clone of the source repository, only used for backfilling
.cache/

__pycache__/
*.pyc
.DS_Store
